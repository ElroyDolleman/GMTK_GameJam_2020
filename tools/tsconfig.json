{
    // Type-checks the Node build scripts. Node runs them directly (type stripping), so nothing is emitted.
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["scripts/**/*.ts"]
}
